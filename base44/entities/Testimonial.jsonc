{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Guest name"
    },
    "meta": {
      "type": "string",
      "description": "Short context, e.g. Family dinner, DHA"
    },
    "rating": {
      "type": "number",
      "description": "Star rating from 1 to 5"
    },
    "quote": {
      "type": "string",
      "description": "The review text"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Uncheck to hide from the website"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "quote"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}