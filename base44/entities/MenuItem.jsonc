{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Dish name as shown on the menu"
    },
    "slug": {
      "type": "string",
      "description": "Stable identifier used for links and image matching"
    },
    "description": {
      "type": "string",
      "description": "Short appetising description"
    },
    "price": {
      "type": "number",
      "description": "Price in PKR"
    },
    "category": {
      "type": "string",
      "enum": [
        "burgers",
        "pizza",
        "chicken",
        "grilled",
        "sandwiches",
        "sides",
        "desserts",
        "drinks"
      ],
      "enumColors": [
        "red",
        "yellow",
        "purple",
        "pink",
        "blue",
        "gray",
        "green",
        "blue"
      ],
      "description": "Menu category the dish belongs to"
    },
    "badge": {
      "type": "string",
      "enum": [
        "bestseller",
        "new"
      ],
      "enumColors": [
        "red",
        "green"
      ],
      "description": "Optional highlight label"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL; falls back to the bundled photo"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order on the menu"
    },
    "available": {
      "type": "boolean",
      "default": true,
      "description": "Uncheck to hide from the public menu"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}