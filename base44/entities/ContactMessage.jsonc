{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "enum": [
        "General enquiry",
        "Table booking",
        "Large order / catering",
        "Feedback",
        "Careers"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "default": "General enquiry"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "replied",
        "archived"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}