{
  "name": "Subscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "website-footer"
    },
    "status": {
      "type": "string",
      "enum": [
        "subscribed",
        "unsubscribed"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "subscribed"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}